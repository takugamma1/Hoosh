{{ 'hoosh-main.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
-%}

<section class="h404 h-section" data-hoosh>
  <div class="h-container">
    <div class="h404__wrap h-reveal">

      <div class="h404__code" aria-hidden="true">
        <span>4</span><span class="h404__zero">0</span><span>4</span>
      </div>

      {%- if s.label != blank -%}
        <span class="h-label">{{ s.label }}</span>
      {%- endif -%}
      <h1 class="h-display h404__heading">{{ s.heading | default: 'Страницата не е намерена.' }}</h1>
      {%- if s.lead != blank -%}
        <p class="h-body h404__lead">{{ s.lead }}</p>
      {%- endif -%}

      {%- if s.show_search -%}
        <form action="{{ routes.search_url }}" method="get" role="search" class="h404__search">
          <input
            class="h404__input"
            type="search"
            name="q"
            placeholder="{{ s.search_placeholder | default: 'Потърси продукт или вкус…' | escape }}"
            aria-label="{{ s.search_placeholder | default: 'Търсене' | escape }}"
          >
          <button type="submit" class="h404__search-btn" aria-label="Търси">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.35-4.35"/></svg>
          </button>
        </form>
      {%- endif -%}

      <div class="h404__actions">
        <a href="{{ routes.root_url }}" class="h-btn h-btn--primary">{{ s.home_label | default: 'Към началото' }}</a>
        <a href="{{ s.catalog_link | default: routes.collections_url }}" class="h-btn h-btn--outline">{{ s.catalog_label | default: 'Разгледай каталога' }}</a>
      </div>

      {%- assign quick_links = section.blocks | where: 'type', 'link' -%}
      {%- if quick_links.size > 0 -%}
        <div class="h404__quick">
          <span class="h404__quick-label">{{ s.quick_heading | default: 'Или директно към:' }}</span>
          <ul class="h404__quick-list" role="list">
            {%- for block in quick_links -%}
              {%- if block.settings.title != blank and block.settings.url != blank -%}
                <li {{ block.shopify_attributes }}>
                  <a href="{{ block.settings.url }}" class="h404__quick-link">{{ block.settings.title }} <span aria-hidden="true">→</span></a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      {%- if s.whatsapp != blank -%}
        <p class="h404__help h-small">
          {{ s.help_text | default: 'Не откриваш това, което търсиш?' }}
          <a href="https://wa.me/{{ s.whatsapp }}" target="_blank" rel="noopener noreferrer">{{ s.whatsapp_label | default: 'Пиши ни в WhatsApp' }}</a>
        </p>
      {%- endif -%}

    </div>
  </div>
</section>

<style>
  .h404 {
    background: var(--h-bg);
    padding: clamp(48px, 9vw, 110px) 0;
  }
  .h404__wrap {
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .h404__code {
    font-family: var(--h-font-display);
    font-size: clamp(110px, 22vw, 220px);
    line-height: 0.9;
    letter-spacing: 0.04em;
    color: var(--h-text);
    display: flex;
  }
  .h404__zero {
    color: var(--h-pink);
    animation: h404-pulse 2.4s ease-in-out infinite;
  }
  @keyframes h404-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.45; }
  }
  .h404 .h-label { margin-top: 18px; }
  .h404__heading {
    font-size: clamp(30px, 5vw, 52px);
    margin: 10px 0 0;
  }
  .h404__lead {
    margin: 14px 0 0;
    max-width: 46ch;
    font-size: 16px;
  }

  .h404__search {
    display: flex;
    width: 100%;
    max-width: 440px;
    margin-top: 26px;
    position: relative;
  }
  .h404 .h404__input {
    width: 100%;
    background: var(--h-bg-card);
    border: 1px solid var(--h-border-accent);
    border-radius: 999px;
    color: var(--h-text);
    font-family: var(--h-font-body);
    font-size: 15px;
    padding: 14px 54px 14px 22px;
    transition: border-color 0.2s ease;
  }
  .h404 .h404__input::placeholder { color: var(--h-text-muted); }
  .h404 .h404__input:focus {
    outline: none;
    border-color: var(--h-pink);
  }
  .h404__search-btn {
    position: absolute;
    right: 6px;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: none;
    background: var(--h-pink);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .h404__search-btn:hover { background: var(--h-pink-hover); }

  .h404__actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 26px;
  }

  .h404__quick {
    margin-top: clamp(28px, 4vw, 40px);
  }
  .h404__quick-label {
    display: block;
    font-family: var(--h-font-body);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--h-text-muted);
    margin-bottom: 12px;
  }
  .h404__quick-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
  }
  .h404__quick-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--h-font-body);
    font-size: 14px;
    color: var(--h-text-secondary);
    text-decoration: none;
    border: 1px solid var(--h-border-accent);
    border-radius: 999px;
    padding: 8px 16px;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .h404__quick-link:hover {
    color: var(--h-text);
    border-color: var(--h-pink);
  }

  .h404__help {
    margin: clamp(26px, 4vw, 36px) 0 0;
  }
  .h404__help a { color: var(--h-green); }

  @media (max-width: 560px) {
    .h404__actions { flex-direction: column; width: 100%; }
    .h404__actions .h-btn { width: 100%; }
  }
</style>

{% schema %}
{
  "name": "HOOSH 404",
  "tag": "section",
  "class": "hoosh-section",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Грешка 404" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Страницата не е намерена." },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Text",
      "default": "Страницата, която търсиш, е преместена или вече не съществува. Но най-доброто от HOOSH е само на един клик."
    },
    { "type": "header", "content": "Search" },
    { "type": "checkbox", "id": "show_search", "label": "Show search field", "default": true },
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Потърси продукт или вкус…" },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "home_label", "label": "Home button label", "default": "Към началото" },
    { "type": "text", "id": "catalog_label", "label": "Catalog button label", "default": "Разгледай каталога" },
    { "type": "url", "id": "catalog_link", "label": "Catalog button link", "info": "Defaults to the collections list." },
    { "type": "header", "content": "Quick links" },
    { "type": "text", "id": "quick_heading", "label": "Quick links heading", "default": "Или директно към:" },
    { "type": "header", "content": "Help" },
    { "type": "text", "id": "help_text", "label": "Help text", "default": "Не откриваш това, което търсиш?" },
    { "type": "text", "id": "whatsapp", "label": "WhatsApp number", "info": "International format, no + sign", "default": "359886969757" },
    { "type": "text", "id": "whatsapp_label", "label": "WhatsApp link label", "default": "Пиши ни в WhatsApp" }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Quick link",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "HOOSH 404" }]
}
{% endschema %}
