{{ 'hoosh-main.css' | asset_url | stylesheet_tag }}

<section class="hoosh-about h-section" data-hoosh>
  <div class="h-container">

    {%- comment -%} ── Intro ── {%- endcomment -%}
    <div class="hoosh-about__intro h-reveal">
      <span class="h-label">{{ section.settings.label | default: 'За нас' }}</span>
      <h1 class="h-display hoosh-about__heading">{{ section.settings.heading | default: 'Новата ера на наргилетата' }}</h1>
      <p class="h-body hoosh-about__lead">{{ section.settings.lead }}</p>
    </div>

    {%- comment -%} ── Story rows ── {%- endcomment -%}
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'story' -%}
          <div class="hoosh-about__story h-reveal{% if block.settings.reverse %} hoosh-about__story--reverse{% endif %}" {{ block.shopify_attributes }}>
            <div class="hoosh-about__story-media">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 900 }}"
                  srcset="{{ block.settings.image | image_url: width: 600 }} 600w, {{ block.settings.image | image_url: width: 900 }} 900w"
                  sizes="(min-width: 768px) 45vw, 90vw"
                  alt="{{ block.settings.heading | escape }}"
                  loading="lazy"
                >
              {%- else -%}
                <div class="hoosh-about__story-placeholder">
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--h-pink)" stroke-width="1.5" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
                </div>
              {%- endif -%}
            </div>
            <div class="hoosh-about__story-text">
              <span class="h-label">{{ block.settings.label }}</span>
              <h2 class="h-display hoosh-about__story-heading">{{ block.settings.heading }}</h2>
              <div class="h-body">{{ block.settings.text }}</div>
            </div>
          </div>

        {%- when 'stat' -%}
          {%- comment -%} Stats are gathered below {%- endcomment -%}
      {%- endcase -%}
    {%- endfor -%}

    {%- comment -%} ── Stats row ── {%- endcomment -%}
    {%- assign stat_blocks = section.blocks | where: 'type', 'stat' -%}
    {%- if stat_blocks.size > 0 -%}
      <div class="hoosh-about__stats h-reveal">
        {%- for block in stat_blocks -%}
          <div class="hoosh-about__stat" {{ block.shopify_attributes }}>
            <span class="hoosh-about__stat-value" style="color: {{ block.settings.color | default: '#FF1493' }};">{{ block.settings.value }}</span>
            <span class="hoosh-about__stat-label">{{ block.settings.text }}</span>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} ── Values grid ── {%- endcomment -%}
    {%- assign value_blocks = section.blocks | where: 'type', 'value' -%}
    {%- if value_blocks.size > 0 -%}
      <div class="hoosh-about__values h-reveal">
        {%- for block in value_blocks -%}
          <div class="hoosh-about__value" {{ block.shopify_attributes }}>
            <span class="hoosh-about__value-num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <h3 class="hoosh-about__value-heading">{{ block.settings.heading }}</h3>
            <p class="h-body hoosh-about__value-text">{{ block.settings.text }}</p>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

<style>
  .hoosh-about {
    background: var(--h-bg);
  }
  .hoosh-about .h-container {
    display: flex;
    flex-direction: column;
    gap: var(--h-section-py);
  }

  /* ── Intro ── */
  .hoosh-about__intro {
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }
  .hoosh-about__heading {
    font-size: var(--h-hero);
    margin-bottom: 24px;
  }
  .hoosh-about__lead {
    max-width: 620px;
    margin: 0 auto;
    font-size: var(--h-body);
  }

  /* ── Story rows ── */
  .hoosh-about__story {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .hoosh-about__story--reverse .hoosh-about__story-media {
    order: 2;
  }
  .hoosh-about__story-media img {
    width: 100%;
    height: auto;
    border-radius: var(--h-card-radius);
    display: block;
  }
  .hoosh-about__story-placeholder {
    background: var(--h-bg-card);
    border: 1px solid var(--h-border-accent);
    border-radius: var(--h-card-radius);
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hoosh-about__story-heading {
    font-size: var(--h-section-title);
    margin-bottom: 20px;
  }
  .hoosh-about__story-text .h-body p {
    margin: 0 0 1em;
  }
  .hoosh-about__story-text .h-body p:last-child {
    margin-bottom: 0;
  }

  /* ── Stats ── */
  .hoosh-about__stats {
    display: flex;
    justify-content: center;
    gap: clamp(2rem, 8vw, 7rem);
    flex-wrap: wrap;
    border-top: 1px solid var(--h-border);
    border-bottom: 1px solid var(--h-border);
    padding: clamp(2rem, 4vw, 3.5rem) 0;
  }
  .hoosh-about__stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-align: center;
  }
  .hoosh-about__stat-value {
    font-family: var(--h-font-display);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1;
  }
  .hoosh-about__stat-label {
    font-family: var(--h-font-body);
    font-size: var(--h-small);
    color: var(--h-text-secondary);
    text-transform: uppercase;
    letter-spacing: var(--h-tracking-wide);
  }

  /* ── Values ── */
  .hoosh-about__values {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--h-card-gap);
  }
  .hoosh-about__value {
    background: var(--h-bg-card);
    border: 1px solid var(--h-border);
    border-radius: var(--h-card-radius);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    transition: border-color 0.4s var(--h-ease);
  }
  .hoosh-about__value:hover {
    border-color: var(--h-pink);
  }
  .hoosh-about__value-num {
    font-family: var(--h-font-display);
    font-size: 1rem;
    color: var(--h-green);
    letter-spacing: var(--h-tracking-wide);
    display: block;
    margin-bottom: 16px;
  }
  .hoosh-about__value-heading {
    font-family: var(--h-font-display);
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    color: var(--h-text);
    text-transform: uppercase;
    letter-spacing: var(--h-tracking-tight);
    line-height: 1;
    margin: 0 0 12px;
  }
  .hoosh-about__value-text {
    font-size: var(--h-small);
  }

  @media screen and (max-width: 767px) {
    .hoosh-about__story {
      grid-template-columns: 1fr;
    }
    .hoosh-about__story--reverse .hoosh-about__story-media {
      order: 0;
    }
  }
</style>

{% schema %}
{
  "name": "HOOSH About",
  "class": "hoosh-section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "За нас"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Новата ера на наргилетата"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Intro text",
      "default": "HOOSH е повече от наргиле — това е нов ритуал. Електрическа шиша без въглени и без компромис, създадена за хора, които ценят стила, вкуса и свободата."
    }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "Story row",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "checkbox", "id": "reverse", "label": "Image on the right", "default": false },
        { "type": "text", "id": "label", "label": "Label", "default": "Нашата история" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Роден от страст" },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Създадохме HOOSH, за да преоткрием изживяването с наргиле — без дим, без въглени, без чакане. Само чист вкус и модерен дизайн, готови за секунди.</p>"
        }
      ]
    },
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "10+" },
        { "type": "text", "id": "text", "label": "Label", "default": "Уникални вкуса" },
        { "type": "color", "id": "color", "label": "Accent color", "default": "#FF1493" }
      ]
    },
    {
      "type": "value",
      "name": "Value card",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Иновация" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Технология, която превръща ритуала в изживяване." }
      ]
    }
  ],
  "presets": [
    {
      "name": "HOOSH About",
      "blocks": [
        { "type": "story" },
        { "type": "stat", "settings": { "value": "10+", "text": "Уникални вкуса", "color": "#FF1493" } },
        { "type": "stat", "settings": { "value": "0", "text": "Въглени и дим", "color": "#00E676" } },
        { "type": "stat", "settings": { "value": "100%", "text": "Електрическо изживяване", "color": "#FF1493" } },
        { "type": "value" }
      ]
    }
  ]
}
{% endschema %}
