{{ 'hoosh-main.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign per_page = s.per_page | default: 9
-%}

{%- paginate blog.articles by per_page -%}
<section class="hbl h-section" data-hoosh>
  <div class="h-container">

    <div class="hbl__header h-reveal">
      {%- if s.label != blank -%}
        <span class="h-label">{{ s.label }}</span>
      {%- endif -%}
      <h1 class="h-display hbl__heading">{{ blog.title }}</h1>
      {%- if s.lead != blank -%}
        <p class="h-body hbl__lead">{{ s.lead }}</p>
      {%- endif -%}
    </div>

    {%- if blog.articles.size > 0 -%}
      <div class="hbl__grid">
        {%- for article in blog.articles -%}
          <article class="hbl__card h-reveal">
            <a href="{{ article.url }}" class="hbl__card-link">
              <div class="hbl__media">
                {%- if article.image != blank -%}
                  {{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', class: 'hbl__img', alt: article.image.alt | default: article.title }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'hbl__img hbl__placeholder' }}
                {%- endif -%}
              </div>
              <div class="hbl__body">
                <time class="hbl__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%d.%m.%Y' }}</time>
                <h2 class="hbl__title">{{ article.title }}</h2>
                {%- assign excerpt = article.excerpt_or_content | strip_html | truncate: 140 -%}
                {%- if excerpt != blank -%}
                  <p class="hbl__excerpt">{{ excerpt }}</p>
                {%- endif -%}
                <span class="hbl__more">{{ s.read_more_label | default: 'Прочети още' }} <span aria-hidden="true">→</span></span>
              </div>
            </a>
          </article>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="hbl__pagination" aria-label="{{ 'Пагинация' }}">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" class="hbl__page hbl__page--arrow">‹</a>
          {%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}" class="hbl__page">{{ part.title }}</a>
            {%- else -%}
              <span class="hbl__page{% if part.title == paginate.current_page %} is-active{% endif %}">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" class="hbl__page hbl__page--arrow">›</a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- else -%}
      <div class="hbl__empty h-reveal">
        <h2 class="h-display hbl__empty-title">{{ s.empty_heading | default: 'Очаквай скоро.' }}</h2>
        {%- if s.empty_text != blank -%}
          <p class="h-body hbl__empty-text">{{ s.empty_text }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</section>
{%- endpaginate -%}

<style>
  .hbl {
    background: var(--h-bg);
    padding: clamp(48px, 8vw, 96px) 0;
  }
  .hbl__header {
    margin-bottom: clamp(28px, 5vw, 48px);
  }
  .hbl__heading {
    font-size: clamp(44px, 6.5vw, 88px);
    line-height: 0.95;
    margin: 12px 0 0;
  }
  .hbl__lead {
    margin: 16px 0 0;
    max-width: 56ch;
    font-size: 17px;
  }

  .hbl__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .hbl__card {
    background: var(--h-bg-card);
    border: 1px solid var(--h-border);
    border-radius: 16px;
    overflow: hidden;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }
  .hbl__card:hover {
    transform: translateY(-4px);
    border-color: var(--h-pink);
  }
  .hbl__card-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .hbl__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--h-bg-elevated);
  }
  .hbl__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .hbl__card:hover .hbl__img { transform: scale(1.05); }
  .hbl__placeholder { fill: var(--h-text-muted); }
  .hbl__body {
    padding: 20px 22px 24px;
  }
  .hbl__date {
    font-family: var(--h-font-body);
    font-size: 13px;
    color: var(--h-text-muted);
    letter-spacing: 0.04em;
  }
  .hbl__title {
    font-family: var(--h-font-display);
    font-size: clamp(22px, 2.2vw, 28px);
    letter-spacing: 0.02em;
    line-height: 1.05;
    color: var(--h-text);
    text-transform: uppercase;
    margin: 10px 0 0;
  }
  .hbl__excerpt {
    font-family: var(--h-font-body);
    font-size: 14px;
    line-height: 1.6;
    color: var(--h-text-secondary);
    margin: 10px 0 0;
  }
  .hbl__more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 16px;
    font-family: var(--h-font-body);
    font-size: 14px;
    font-weight: 600;
    color: var(--h-pink);
  }
  .hbl__card:hover .hbl__more { color: var(--h-pink-hover); }

  .hbl__pagination {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: clamp(32px, 5vw, 48px);
  }
  .hbl__page {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 42px;
    height: 42px;
    padding: 0 12px;
    border: 1px solid var(--h-border-accent);
    border-radius: 10px;
    font-family: var(--h-font-body);
    font-size: 15px;
    color: var(--h-text-secondary);
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  a.hbl__page:hover {
    border-color: var(--h-pink);
    color: var(--h-text);
  }
  .hbl__page.is-active {
    background: var(--h-pink);
    border-color: var(--h-pink);
    color: #fff;
  }

  .hbl__empty {
    text-align: center;
    padding: clamp(48px, 10vw, 120px) 0;
  }
  .hbl__empty-title {
    font-size: clamp(40px, 6vw, 72px);
    margin: 0;
  }
  .hbl__empty-text {
    margin: 16px auto 0;
    max-width: 48ch;
  }

  @media (max-width: 900px) {
    .hbl__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .hbl__grid { grid-template-columns: 1fr; }
  }
</style>

{% schema %}
{
  "name": "HOOSH Blog",
  "tag": "section",
  "class": "hoosh-section",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Блог" },
    { "type": "textarea", "id": "lead", "label": "Intro text" },
    {
      "type": "range",
      "id": "per_page",
      "label": "Articles per page",
      "min": 3,
      "max": 24,
      "step": 3,
      "default": 9
    },
    { "type": "text", "id": "read_more_label", "label": "Read more label", "default": "Прочети още" },
    { "type": "header", "content": "Empty state" },
    { "type": "text", "id": "empty_heading", "label": "Empty heading", "default": "Очаквай скоро." },
    {
      "type": "textarea",
      "id": "empty_text",
      "label": "Empty text",
      "default": "Подготвяме първите статии. Последвай ни в социалните мрежи, за да не изпуснеш нищо."
    }
  ],
  "presets": [{ "name": "HOOSH Blog" }]
}
{% endschema %}
