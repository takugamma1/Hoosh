{{ 'hoosh-main.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign label_v = s.label | default: '' | strip
  assign sub_v = s.subheading | default: '' | strip
  assign head_v = s.heading | default: '' | strip
  assign pill_v = s.pill_text | default: '' | strip
  assign vid_v = s.video_text | default: '' | strip

  assign has_label = false
  assign has_sub = false
  assign has_head = false
  assign has_pill = false
  assign has_video = false
  if label_v != '' and label_v != blank
    assign has_label = true
  endif
  if sub_v != '' and sub_v != blank
    assign has_sub = true
  endif
  if head_v != '' and head_v != blank
    assign has_head = true
  endif
  if pill_v != '' and pill_v != blank and s.hide_pill != true
    assign has_pill = true
  endif
  if vid_v != '' and vid_v != blank and s.video_url != blank
    assign has_video = true
  endif
  assign has_header = false
  if has_label or has_sub or has_head or has_pill or has_video
    assign has_header = true
  endif
  if s.hide_header
    assign has_header = false
  endif

  assign cols_mobile = s.per_row_mobile | default: 2
  assign uid = section.id

  assign bg_color = s.bg_color | default: '#000000'
  assign heading_color = s.heading_color | default: '#ffffff'
  assign sub_color = s.sub_color | default: '#8a8a8a'
  assign label_text = s.label_text | default: '#00e38a'
-%}

<section
  id="hmg-{{ uid }}"
  class="hmg{% unless has_header %} hmg--no-header{% endunless %}"
  style="
    --hmg-cols-m: {{ cols_mobile }};
    --hmg-bg: {{ bg_color }};
    --hmg-heading: {{ heading_color }};
    --hmg-sub: {{ sub_color }};
    --hmg-label-text: {{ label_text }};
  "
  data-hoosh
>
  <div class="h-container">
    {%- if has_header -%}
      <div class="hmg__head h-reveal">
        {%- if has_pill -%}
          {%- if s.pill_link != blank -%}
            <a class="hmg__pill" href="{{ s.pill_link }}"><span>{{ pill_v }}</span></a>
          {%- else -%}
            <span class="hmg__pill"><span>{{ pill_v }}</span></span>
          {%- endif -%}
        {%- endif -%}
        {%- if has_label -%}<span class="hmg__label">{{ label_v }}</span>{%- endif -%}
        {%- if has_sub -%}<span class="hmg__sub">{{ sub_v }}</span>{%- endif -%}
        {%- if has_head -%}<h2 class="hmg__title h-display">{{ head_v }}</h2>{%- endif -%}
        {%- if has_video -%}
          <button type="button" class="hmg__video" data-h-video-open="{{ uid }}" aria-haspopup="dialog">
            <span class="hmg__video-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </span>
            <span>{{ vid_v }}</span>
          </button>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul class="hmg__grid">
      {%- if s.collection != blank and s.collection.products.size > 0 -%}
        {%- for product in s.collection.products limit: s.max_products -%}
          <li class="hmg__item">
            {% render 'hoosh-product-card', product: product %}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..6) -%}
          <li class="hmg__item">
            {% render 'hoosh-product-card' %}
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>

  {%- if has_video -%}
    {% render 'hoosh-video-modal', unique_id: uid, video_url: s.video_url, label: vid_v %}
  {%- endif -%}
</section>

<style>
  #hmg-{{ uid }}.hmg {
    display: none;
    background: var(--hmg-bg);
    padding-block-start: clamp(3rem, 7vw, 6rem);
    padding-block-end: clamp(3rem, 7vw, 6rem);
  }
  #hmg-{{ uid }}.hmg--no-header {
    padding-block-start: clamp(0.75rem, 2vw, 1.5rem);
    padding-block-end: clamp(0.75rem, 2vw, 1.5rem);
  }

  #hmg-{{ uid }} .hmg__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: clamp(2rem, 5vw, 4rem);
  }
  #hmg-{{ uid }} .hmg__pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    font-family: var(--h-font-display, 'Bebas Neue Cyrillic', 'Bebas Neue', sans-serif);
    font-weight: 400;
    font-size: 1.05rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #1a1a1a;
    background: linear-gradient(180deg, #f4f4f4 0%, #d6d6d6 50%, #b9b9b9 100%);
    border: 1px solid rgba(255,255,255,0.35);
    border-radius: 999px;
    padding: 14px 36px;
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.7),
      inset 0 -1px 0 rgba(0,0,0,0.15),
      0 6px 18px rgba(0,0,0,0.45);
    margin: 0 0 1.8em;
    transition: transform 0.2s ease, filter 0.2s ease;
  }
  #hmg-{{ uid }} a.hmg__pill:hover {
    transform: translateY(-1px);
    filter: brightness(1.05);
  }
  #hmg-{{ uid }} .hmg__label {
    display: inline-block;
    font-family: var(--h-font-body, 'Outfit', sans-serif);
    color: var(--hmg-label-text);
    font-size: 0.78rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin: 0 0 1.2em;
  }
  #hmg-{{ uid }} .hmg__sub {
    display: block;
    font-family: var(--h-font-body, 'Outfit', sans-serif);
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--hmg-sub);
    margin: 0 0 1em;
  }
  #hmg-{{ uid }} .hmg__title {
    font-size: var(--h-section-title);
    color: var(--hmg-heading);
    margin: 0;
  }
  #hmg-{{ uid }} .hmg__video {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 8px 18px 8px 8px;
    margin-top: clamp(1rem, 2.5vw, 1.6rem);
    border-radius: 999px;
    border: none;
    background: transparent;
    color: #fff;
    font-family: var(--h-font-body, 'Outfit', sans-serif);
    font-size: 0.85rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
    transition: transform 0.2s ease, color 0.2s ease;
  }
  #hmg-{{ uid }} .hmg__video:hover { transform: translateY(-1px); color: #00e38a; }
  #hmg-{{ uid }} .hmg__video-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #fff;
    color: #000;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
  }
  #hmg-{{ uid }} .hmg__video-icon svg { width: 20px; height: 20px; }

  #hmg-{{ uid }} .hmg__grid {
    display: grid;
    grid-template-columns: repeat(var(--hmg-cols-m, 2), 1fr);
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  #hmg-{{ uid }} .hmg__item {
    min-width: 0;
    display: flex;
  }
  #hmg-{{ uid }} .hmg__item > .hp-card {
    width: 100%;
    height: 100%;
  }

  @media screen and (max-width: 767px) {
    #hmg-{{ uid }}.hmg {
      display: block;
    }
    #hmg-{{ uid }} .h-container {
      max-width: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "HOOSH Mobile Grid",
  "tag": "section",
  "class": "hoosh-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "This section is hidden on desktop and visible only on mobile (under 768px). Use it to mirror a slider as a tap-friendly grid for phone users."
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "checkbox",
      "id": "hide_header",
      "label": "Hide header",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_pill",
      "label": "Hide silver pill button",
      "default": false
    },
    {
      "type": "text",
      "id": "pill_text",
      "label": "Silver pill text (above label)",
      "info": "Leave empty to hide. Renders as a silver rounded button."
    },
    {
      "type": "url",
      "id": "pill_link",
      "label": "Silver pill link (optional)"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Category label"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Small caption (above heading)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "video_text",
      "label": "Video button text",
      "info": "Renders a play-icon button under the heading. Leave empty to hide."
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "Video URL (mp4, YouTube, Vimeo)",
      "info": "Opens in a popup when the button is clicked."
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Max products in grid",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 12
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "per_row_mobile",
      "label": "Products per row (mobile)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "sub_color",
      "label": "Small caption color",
      "default": "#8a8a8a"
    },
    {
      "type": "color",
      "id": "label_text",
      "label": "Category label text",
      "default": "#00e38a"
    }
  ],
  "presets": [
    {
      "name": "HOOSH Mobile Grid",
      "settings": {
        "pill_text": "КАТАЛОГ HOOSH",
        "label": "Разгледай",
        "heading": "НАЙ-ПРОДАВАНИТЕ ПРОДУКТИ",
        "max_products": 12,
        "per_row_mobile": 2
      }
    }
  ]
}
{% endschema %}
