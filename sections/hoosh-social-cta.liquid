{{ 'hoosh-main.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign uid = section.id
  assign vid_v = s.video_text | default: '' | strip
  assign has_video = false
  if vid_v != '' and vid_v != blank and s.video_url != blank
    assign has_video = true
  endif

  assign bg_color = s.bg_color | default: '#000000'
  assign label_color = s.label_color | default: '#ffffff'
  assign heading_color = s.heading_color | default: '#ffffff'
  assign body_color = s.body_color | default: 'rgba(255,255,255,0.78)'
-%}

<section
  id="hsc-{{ uid }}"
  class="hsc"
  style="
    --hsc-bg: {{ bg_color }};
    --hsc-label: {{ label_color }};
    --hsc-heading: {{ heading_color }};
    --hsc-body: {{ body_color }};
  "
  data-hoosh
>
  {%- if s.bg_image != blank -%}
    <div class="hsc__bg-image" aria-hidden="true">
      {{ s.bg_image | image_url: width: 1600 | image_tag:
          loading: 'lazy',
          widths: '600,900,1200,1600',
          sizes: '(min-width: 1024px) 60vw, 100vw',
          alt: ''
      }}
    </div>
  {%- else -%}
    <div class="hsc__glow" aria-hidden="true"></div>
  {%- endif -%}

  <div class="h-container hsc__inner">
    <div class="hsc__grid">
      <div class="hsc__content h-reveal">
        {%- if s.label != blank -%}
          <span class="hsc__label">{{ s.label }}</span>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="hsc__title h-display">{{ s.heading }}</h2>
        {%- endif -%}
        {%- if s.description != blank -%}
          <p class="hsc__desc">{{ s.description }}</p>
        {%- endif -%}

        <div class="hsc__cta-row">
          {%- if section.blocks.size > 0 -%}
            <ul class="hsc__socials">
              {%- for block in section.blocks -%}
                {%- if block.type == 'social_link' and block.settings.url != blank -%}
                  <li {{ block.shopify_attributes }}>
                    <a
                      class="hsc__social-btn"
                      href="{{ block.settings.url }}"
                      target="_blank"
                      rel="noopener"
                      aria-label="{{ block.settings.platform | capitalize }}"
                    >
                      {%- case block.settings.platform -%}
                        {%- when 'instagram' -%}
                          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                        {%- when 'youtube' -%}
                          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                        {%- when 'tiktok' -%}
                          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5.8 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1.84-.1z"/></svg>
                        {%- when 'discord' -%}
                          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.291a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.099.246.197.373.291a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
                        {%- when 'facebook' -%}
                          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                        {%- when 'x' -%}
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                        {%- when 'telegram' -%}
                          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
                        {%- when 'whatsapp' -%}
                          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163a11.867 11.867 0 0 1-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 0 1 8.413 3.488 11.824 11.824 0 0 1 3.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 0 0 1.51 5.26l-.999 3.648 3.978-.607zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.149-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
                      {%- endcase -%}
                    </a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- if has_video -%}
            <button
              type="button"
              class="hsc__video-btn"
              data-h-video-open="{{ uid }}"
              aria-haspopup="dialog"
            >
              <span class="hsc__video-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              </span>
              <span>{{ vid_v }}</span>
            </button>
          {%- endif -%}
        </div>
      </div>

      <div class="hsc__media hsc__media--video h-reveal">
        {%- if has_video -%}
          <button
            type="button"
            class="hsc__tile-btn"
            data-h-video-open="{{ uid }}"
            aria-label="{{ vid_v | escape }}"
          >
            {%- if s.image_video != blank -%}
              {{ s.image_video | image_url: width: 800 | image_tag:
                  loading: 'lazy',
                  widths: '400,600,800,1000',
                  sizes: '(min-width: 1024px) 30vw, 45vw',
                  alt: s.image_video.alt | default: 'HOOSH'
              }}
            {%- else -%}
              <div class="hsc__placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
            {%- endif -%}
            <span class="hsc__play-overlay" aria-hidden="true">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </span>
          </button>
        {%- else -%}
          {%- if s.image_video != blank -%}
            {{ s.image_video | image_url: width: 800 | image_tag:
                loading: 'lazy',
                widths: '400,600,800,1000',
                sizes: '(min-width: 1024px) 30vw, 45vw',
                alt: s.image_video.alt | default: 'HOOSH'
            }}
          {%- else -%}
            <div class="hsc__placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
          {%- endif -%}
        {%- endif -%}
      </div>

      <div class="hsc__media hsc__media--photo h-reveal">
        {%- if s.image_photo != blank -%}
          {{ s.image_photo | image_url: width: 800 | image_tag:
              loading: 'lazy',
              widths: '400,600,800,1000',
              sizes: '(min-width: 1024px) 30vw, 45vw',
              alt: s.image_photo.alt | default: 'HOOSH community'
          }}
        {%- else -%}
          <div class="hsc__placeholder">{{ 'lifestyle-1' | placeholder_svg_tag }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- if has_video -%}
    {% render 'hoosh-video-modal', unique_id: uid, video_url: s.video_url, label: vid_v %}
  {%- endif -%}
</section>

<style>
  #hsc-{{ uid }}.hsc {
    position: relative;
    background: var(--hsc-bg);
    padding-block: clamp(3rem, 7vw, 6rem);
    overflow: hidden;
  }
  #hsc-{{ uid }} .hsc__glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 50% 35% at 25% 50%, rgba(180, 55, 220, 0.18), transparent 70%),
      radial-gradient(ellipse 45% 30% at 75% 60%, rgba(60, 30, 120, 0.22), transparent 70%);
    z-index: 0;
  }
  #hsc-{{ uid }} .hsc__bg-image {
    position: absolute;
    top: 50%;
    left: -5%;
    transform: translateY(-50%);
    width: 70%;
    height: 130%;
    pointer-events: none;
    z-index: 0;
    opacity: 0.85;
    mix-blend-mode: screen;
  }
  #hsc-{{ uid }} .hsc__bg-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: left center;
  }
  #hsc-{{ uid }} .hsc__inner { position: relative; z-index: 1; }

  #hsc-{{ uid }} .hsc__grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr 1fr;
    gap: clamp(1.25rem, 3vw, 3rem);
    align-items: center;
  }

  #hsc-{{ uid }} .hsc__content {
    display: flex;
    flex-direction: column;
  }
  #hsc-{{ uid }} .hsc__label {
    font-family: var(--h-font-body, 'Outfit', sans-serif);
    font-size: 0.78rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--hsc-label);
    margin: 0 0 1rem;
  }
  #hsc-{{ uid }} .hsc__title {
    font-family: var(--h-font-display, 'Bebas Neue', sans-serif);
    font-size: clamp(2.2rem, 4.4vw, 3.6rem);
    color: var(--hsc-heading);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1.05;
    margin: 0 0 1.4rem;
  }
  #hsc-{{ uid }} .hsc__desc {
    font-family: var(--h-font-body, 'Outfit', sans-serif);
    color: var(--hsc-body);
    font-size: clamp(0.95rem, 1.05vw, 1.05rem);
    line-height: 1.6;
    margin: 0 0 1.8rem;
    max-width: 38ch;
  }

  #hsc-{{ uid }} .hsc__cta-row {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2vw, 1.4rem);
    flex-wrap: wrap;
  }
  #hsc-{{ uid }} .hsc__socials {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  #hsc-{{ uid }} .hsc__social-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
  }
  #hsc-{{ uid }} .hsc__social-btn:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.32);
    transform: translateY(-2px);
  }

  #hsc-{{ uid }} .hsc__video-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 6px 18px 6px 6px;
    border-radius: 999px;
    border: none;
    background: transparent;
    color: #fff;
    font-family: var(--h-font-body, 'Outfit', sans-serif);
    font-size: 0.85rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
    transition: transform 0.2s ease, color 0.2s ease;
  }
  #hsc-{{ uid }} .hsc__video-btn:hover { transform: translateY(-1px); color: #00e38a; }
  #hsc-{{ uid }} .hsc__video-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #fff;
    color: #000;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
  }

  #hsc-{{ uid }} .hsc__media {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.03);
  }
  #hsc-{{ uid }} .hsc__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  #hsc-{{ uid }} .hsc__media:hover img { transform: scale(1.04); }
  #hsc-{{ uid }} .hsc__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.18;
  }

  #hsc-{{ uid }} .hsc__tile-btn {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: none;
    background: transparent;
    cursor: pointer;
  }
  #hsc-{{ uid }} .hsc__play-overlay {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    color: #000;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
    transition: transform 0.2s ease, background 0.2s ease;
  }
  #hsc-{{ uid }} .hsc__tile-btn:hover .hsc__play-overlay {
    transform: translate(-50%, -50%) scale(1.06);
    background: #fff;
  }

  /* Tablet */
  @media screen and (max-width: 1023px) {
    #hsc-{{ uid }} .hsc__grid {
      grid-template-columns: 1fr 1fr;
    }
    #hsc-{{ uid }} .hsc__content {
      grid-column: 1 / -1;
      margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
    }
    #hsc-{{ uid }} .hsc__desc { max-width: 60ch; }
  }

  /* Mobile */
  @media screen and (max-width: 767px) {
    #hsc-{{ uid }} .hsc__bg-image {
      top: 0;
      left: -10%;
      transform: none;
      width: 120%;
      height: 75%;
      opacity: 0.7;
    }
    #hsc-{{ uid }} .hsc__bg-image img {
      object-position: center top;
    }
    #hsc-{{ uid }} .hsc__grid {
      gap: clamp(0.75rem, 2vw, 1.25rem);
    }
    #hsc-{{ uid }} .hsc__title {
      font-size: clamp(2rem, 7vw, 3rem);
    }
    #hsc-{{ uid }} .hsc__cta-row {
      gap: 0.75rem;
    }
    #hsc-{{ uid }} .hsc__media {
      aspect-ratio: 2 / 3;
    }
    #hsc-{{ uid }} .hsc__play-overlay {
      width: 56px;
      height: 56px;
    }
    #hsc-{{ uid }} .hsc__play-overlay svg { width: 24px; height: 24px; }
  }
</style>

{% schema %}
{
  "name": "HOOSH Social CTA",
  "tag": "section",
  "class": "hoosh-section",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Small label (above heading)",
      "default": "Присъедини се към революцията на наргилетата"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Последвай ни в социалните мрежи"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Последвайте ни в социалните мрежи и се присъединете към HOOSH общността, марката за „Cool Generation\". Открийте най-новите тенденции, споделете опита си и бъдете част от нашата общност от любители на наргиле и вейп."
    },
    {
      "type": "header",
      "content": "Video popup"
    },
    {
      "type": "text",
      "id": "video_text",
      "label": "Video button text",
      "default": "Продуктови указания"
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "Video URL (mp4, YouTube, Vimeo)"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image (behind text)",
      "info": "Smoke / cloud PNG works best. White areas blend out automatically (mix-blend: screen)."
    },
    {
      "type": "image_picker",
      "id": "image_video",
      "label": "Video poster image (middle tile)",
      "info": "Shows a play overlay if a video URL is set."
    },
    {
      "type": "image_picker",
      "id": "image_photo",
      "label": "Photo (right tile)"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label",
      "default": "#ffffff"
