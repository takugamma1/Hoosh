{% doc %}
  Renders all meta tags for the page including Open Graph, Twitter Cards, and SEO tags.

  @param {object} [product] - The product object, available on product pages for price meta tags.
{% enddoc %}

<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1"
>
<meta
  name="view-transition"
  content="same-origin"
>
<meta
  name="theme-color"
  content=""
>

{%- liquid
  # HOOSH: unique per-template SEO fallbacks. They apply only while the page's
  # admin SEO fields (Search engine listing) are empty — admin values always win.
  assign seo_title = page_title
  assign seo_description = page_description

  # The collections list has no admin SEO fields, so it always gets its own copy
  if template.name == 'list-collections'
    assign seo_title = 'Каталог – електрически наргилета, глави и вкусове'
    assign seo_description = 'Разгледай пълния каталог на HOOSH – електрически шиши, E-Heads, E-Pod вкусове и аксесоари. Ново поколение изживяване без дим и без въглен.'
  endif

  if seo_description == blank
    case template.name
      when 'blog'
        assign seo_title = 'Блог – новини и тенденции от света на HOOSH'
        assign seo_description = 'Новини, тенденции и истории от света на HOOSH – електрически наргилета, вкусове и лайфстайл без дим и без въглен.'
      when 'page'
        case template.suffix
          when 'contact'
            assign seo_title = 'Контакти – свържи се с нас'
            assign seo_description = 'Свържи се с екипа на HOOSH – телефон, WhatsApp, имейл и форма за контакт. Отговаряме бързо в работни дни от 09:00 до 18:00 ч.'
          when 'b2b-partner'
            assign seo_title = 'Стани партньор – HOOSH за твоя бизнес'
            assign seo_description = 'Предложи на клиентите си ново поколение изживяване без дим и без въглен. Партньорски условия за ресторанти, барове, магазини и хотели.'
        endcase
    endcase
  endif

  assign og_title = seo_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = seo_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if page_image -%}
  <meta
    property="og:image"
    content="http:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

<title>
  {{ seo_title }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- unless seo_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{% if seo_description %}
  <meta
    name="description"
    content="{{ seo_description | escape }}"
  >
{% endif %}
